<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.exchange</groupId>
    <artifactId>exchange-rate-system</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
            Spring AI has no version relationship to spring-boot-starter-parent's
            dependency management (it's not one of the BOMs the parent imports), so
            it must be pinned explicitly. 2.0.1 is the line built against Spring Boot
            4.1.x (its own POM declares spring-boot-starter-webclient/restclient at
            4.1.1) — matching this project's Boot 4.1.0 parent; 1.x targets Boot 3.x.
        -->
        <spring-ai.version>2.0.1</spring-ai.version>
        <shedlock.version>7.9.0</shedlock.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!--
            Provides a real Jakarta Bean Validation provider (Hibernate Validator).
            Without it, @Valid on a request body is a no-op — MethodArgumentNotValidException
            (which GlobalExceptionHandler maps, T021) would never actually be thrown.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.7.0</version>
        </dependency>
        <!--
            WebClient itself lives in spring-webflux, per plan.md's explicit choice
            ("an HTTP client for the outbound Fixer.io call ... the app is not
            reactive end-to-end"). No reactive server stack (Netty/reactor-netty) is
            pulled in — WebClientConfig backs the client with JdkClientHttpConnector
            (in spring-web, already on the classpath via spring-boot-starter-web),
            so this app stays a plain Spring MVC servlet application; WebClient is
            used purely as a client, blocking synchronously on the one Fixer.io call.
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webflux</artifactId>
        </dependency>
        <!--
            Distributed lock around the daily ingestion scheduler so that
            running more than one instance of this application against the
            same database only ever executes the 00:05 GMT job on one node
            per firing (SchedulingConfig/RateIngestionScheduler). 7.9.0 is
            the line with published Spring Boot 4 / Spring Framework 7
            compatibility. shedlock-provider-jdbc-template needs only a
            plain javax.sql.DataSource + JdbcTemplate, both already on the
            classpath via spring-boot-starter-data-jpa.
        -->
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-spring</artifactId>
            <version>${shedlock.version}</version>
        </dependency>
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-provider-jdbc-template</artifactId>
            <version>${shedlock.version}</version>
        </dependency>
        <!--
            T033: Spring AI's Ollama chat-model starter (plan.md's fixed AI stack —
            Spring AI against a local Ollama model, research.md Decision 2). Brings
            its own auto-configuration that registers OllamaChatModel/ChatClient
            beans from the spring.ai.ollama.* properties below, with no application
            code required to wire them up.
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
            <version>${spring-ai.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Spring Boot 4.x moved @DataJpaTest out of spring-boot-test-autoconfigure
            (which spring-boot-starter-test still pulls in, but which no longer ships
            per-technology test slices) into this dedicated module, with a new package
            (org.springframework.boot.data.jpa.test.autoconfigure). Not transitively
            included by spring-boot-starter-test — must be declared explicitly.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Same Spring Boot 4.x relocation as spring-boot-data-jpa-test above:
            @AutoConfigureMockMvc moved to this dedicated module (new package
            org.springframework.boot.webmvc.test.autoconfigure), not transitively
            pulled in by spring-boot-starter-test.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
                *IT.java classes (e.g. ExchangeRateControllerIT, T030) are
                integration tests by Maven's own naming convention, but
                Surefire's default includes (**/*Test.java, **/*Tests.java)
                never match that suffix, so they would silently never run
                under plain `mvn test`. Failsafe is the standard counterpart
                that does match **/*IT.java, bound to integration-test/verify
                so `mvn verify` runs unit tests (Surefire) and integration
                tests (Failsafe) together; `mvn test` stays fast/unit-only.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
