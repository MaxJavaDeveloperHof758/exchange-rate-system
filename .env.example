# Copy to .env (docker compose reads it automatically) and fill in a real
# Fixer.io key. Everything else already has a sensible default matching
# docker-compose.yml / application.yml - only override what you need to.

# Required - the app fails fast at startup without this.
FIXER_API_KEY=your-fixer-io-key

# Optional overrides (defaults shown):
# FIXER_BASE_URL=http://data.fixer.io/api
# SPRING_PROFILES_ACTIVE=dev
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.2
